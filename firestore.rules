rules_version = '2';

// Firestore security rules for the Architectures portal.
//
// Data model:
//   /users/{uid}/chats/{modelId}        - one doc per model, holds chat message array
//   /users/{uid}/quizAttempts/{attemptId} - one doc per quiz attempt
//   /users/{uid}/deepdives/{modelId}    - cached deep-dive generations per model
//   /users/{uid}/definitions/{definitionId} - saved cue-card term definitions
//
// Every doc lives under the requesting user's own uid — nobody can read or
// write another user's subtree. There is no public/shared collection yet;
// add one explicitly (with its own rule block) if a future feature needs it.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /chats/{modelId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /deepdives/{modelId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /definitions/{definitionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Default deny — anything not explicitly matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
